{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#f0eee8",
    "--editor-surface": "#f0eee8",
    "--card": "#e7e4dc",
    "--popover": "#dcddd4",
    "--primary": "#757575",
    "--secondary": "#cbc7bc",
    "--muted": "#e7e4dc",
    "--accent": "#dcddd4",
    "--border": "#cbc7bc",
    "--input": "#cbc7bc",
    "--sidebar": "#f0eee8",
    "--sidebar-border": "#cbc7bc",
    "--foreground": "#494640",
    "--popover-foreground": "#494640",
    "--primary-foreground": "#f0eee8",
    "--secondary-foreground": "#494640",
    "--muted-foreground": "#746f66",
    "--accent-foreground": "#393630",
    "--ring": "#746f66",
    "--sidebar-foreground": "#494640"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#746f66",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#393630"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#393630"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#494640"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#494640"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#393630"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#494640"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#746f66"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#393630"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#393630"
      }
    },
    {
      "scope": [
        "invalid",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7b7b7b"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#828282"
      }
    }
  ]
}
