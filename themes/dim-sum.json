{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#111110",
    "--editor-surface": "#111110",
    "--card": "#1b1a19",
    "--popover": "#252421",
    "--primary": "#6f8faf",
    "--secondary": "#31302c",
    "--muted": "#1b1a19",
    "--accent": "#252421",
    "--border": "#31302c",
    "--input": "#31302c",
    "--sidebar": "#111110",
    "--sidebar-border": "#31302c",
    "--foreground": "#cecbc1",
    "--popover-foreground": "#cecbc1",
    "--primary-foreground": "#111110",
    "--secondary-foreground": "#cecbc1",
    "--muted-foreground": "#86837a",
    "--accent-foreground": "#dad6cb",
    "--ring": "#86837a",
    "--sidebar-foreground": "#cecbc1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#86837a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#8b7fa8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#6f8faf"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#87965f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#b77a4a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5f9b95"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5f9b95"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#86837a"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#dad6cb"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6f8faf"
      }
    },
    {
      "scope": [
        "invalid",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a85f59"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#87965f"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#b3954d"
      }
    }
  ]
}
