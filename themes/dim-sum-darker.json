{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#111111",
    "--editor-surface": "#111111",
    "--card": "#1a1a1a",
    "--popover": "#242424",
    "--primary": "#7b8798",
    "--secondary": "#303030",
    "--muted": "#1a1a1a",
    "--accent": "#242424",
    "--border": "#303030",
    "--input": "#303030",
    "--sidebar": "#111111",
    "--sidebar-border": "#303030",
    "--foreground": "#c9c9c9",
    "--popover-foreground": "#c9c9c9",
    "--primary-foreground": "#111111",
    "--secondary-foreground": "#c9c9c9",
    "--muted-foreground": "#858585",
    "--accent-foreground": "#d8d8d8",
    "--ring": "#858585",
    "--sidebar-foreground": "#c9c9c9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#858585",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#8d8298"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7b8798"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#82906f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#a4876f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#71908d"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#71908d"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#858585"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d8d8d8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7b8798"
      }
    },
    {
      "scope": [
        "invalid",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a46f6f"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#82906f"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#a49a6f"
      }
    }
  ]
}
