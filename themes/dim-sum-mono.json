{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#0f0f0f",
    "--editor-surface": "#0f0f0f",
    "--card": "#181818",
    "--popover": "#222222",
    "--primary": "#bebebe",
    "--secondary": "#2e2e2e",
    "--muted": "#181818",
    "--accent": "#222222",
    "--border": "#2e2e2e",
    "--input": "#2e2e2e",
    "--sidebar": "#0f0f0f",
    "--sidebar-border": "#2e2e2e",
    "--foreground": "#d0d0d0",
    "--popover-foreground": "#d0d0d0",
    "--primary-foreground": "#0f0f0f",
    "--secondary-foreground": "#d0d0d0",
    "--muted-foreground": "#8a8a8a",
    "--accent-foreground": "#e0e0e0",
    "--ring": "#8a8a8a",
    "--sidebar-foreground": "#d0d0d0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#f2f2f2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#f2f2f2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5e5e5e"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "invalid",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d6d6d6"
      }
    }
  ]
}
